{
  "name": "reality-simulator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "lint": "oxlint src vite.config.ts",
    "scrape:telegram": "node scripts/scrape-telegram-ocr.mjs",
    "scrape:code-hub": "node scripts/scrape-code-hub.mjs",
    "scrape:web": "node scripts/scrape-web-codes.mjs",
    "scrape:all": "node scripts/scrape-all.mjs",
    "discover:telegram": "node scripts/discover-telegram-channels.mjs",
    "schedule:install": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-scheduler.ps1",
    "scrape:telegram:validate": "node scripts/scrape-telegram-ocr.mjs --validate",
    "scrape:code-hub:validate": "node scripts/scrape-code-hub.mjs --validate",
    "book:2h": "node scripts/generate-slips.js --market=2H_HIGHEST --legs=14 --slips=100",
    "book:over15": "node scripts/generate-slips.js --market=OVER_1_5 --legs=17 --slips=100",
    "book:over25": "node scripts/generate-slips.js --market=OVER_2_5 --legs=14 --slips=100",
    "sportybet:setup": "node scripts/sportybet-local-runner.js --setup",
    "sportybet:load": "node scripts/sportybet-local-runner.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.57.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "playwright": "^1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
